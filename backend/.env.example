APP_NAME=CodeAtlas AI
DEBUG=True
ENVIRONMENT=development
API_PREFIX=/api

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0
OLLAMA_MAX_TOKENS=256
OLLAMA_NUM_CTX=2048

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Local development default. On Render, set DATABASE_URL to the PostgreSQL
# connection string from the Render PostgreSQL database (postgres:// and
# postgresql:// are both accepted).
DATABASE_URL=sqlite:///./codeatlas.db
REPOSITORIES_DIR=./data/repos

CHROMA_DB_PATH=./data/chroma

CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=True

LOG_LEVEL=INFO

# Optional custom compiled Tree-sitter grammar directory.
# Leave unset to use the grammars bundled by tree-sitter-languages.
# TREE_SITTER_LANGUAGES_DIR=./data/tree_sitter_languages
